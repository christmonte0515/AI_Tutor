# Copy this file to server/.env and change what you need.
# `npm start` and `npm run dev` load server/.env when it exists.
# Leave JWT_SECRET and DATA_ENCRYPTION_KEY unset to generate them into DATA_DIR
# on first start. Back them up: without DATA_ENCRYPTION_KEY, stored chats cannot be decrypted.

HOST=127.0.0.1
PORT=3000

# Directory for the database and generated secrets. Default: server/data
# DATA_DIR=
# DB_PATH=

# Sign-in token lifetime. Secrets below are generated into DATA_DIR if unset.
# TOKEN_TTL=8h
# JWT_SECRET=
# DATA_ENCRYPTION_KEY=

# Comma-separated student email domains. Empty allows any domain.
ALLOWED_EMAIL_DOMAINS=

# Created on first start when both are set and the email does not exist yet.
# ADMIN_EMAIL=teacher@school.edu
# ADMIN_PASSWORD=

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=700
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_MS=120000

# Off-subject detection: keyword, llm, hybrid, or off
SCOPE_CHECK=hybrid
HISTORY_MESSAGES=12
MAX_MESSAGE_CHARS=2000

# Set to false to stop serving the student UI at /student.
SERVE_WEB_CLIENT=true

# 0 keeps prompt history until a teacher deletes it.
PROMPT_RETENTION_DAYS=0
